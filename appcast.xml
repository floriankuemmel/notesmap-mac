<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  NotesMap Sparkle update feed.

  This file is hosted via raw.githubusercontent.com (see SUFeedURL in
  Info.plist). Sparkle inside the running app polls this every 24h and
  offers any newer version with a valid EdDSA signature.

  Format: https://sparkle-project.org/documentation/publishing/

  Each <item> describes a release. To add a new release:
    1. Build a signed DMG via scripts/release.sh
    2. Run: ./tools/sparkle/bin/sign_update release/NotesMap-X.Y.Z.dmg
       → outputs sparkle:edSignature="…" length="…"
    3. Upload the DMG to GitHub Releases (tag vX.Y.Z)
    4. Add a new <item> at the TOP of <channel> below
    5. Commit + push appcast.xml to main

  v1.0.0 has no <item> entry — it's the initial release; existing users
  do not need to update from a previous version.
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     version="2.0">
    <channel>
        <title>NotesMap</title>
        <link>https://raw.githubusercontent.com/floriankuemmel/notesmap-mac/main/appcast.xml</link>
        <description>NotesMap update feed</description>
        <language>en</language>

        <!-- New <item> entries go here — newest first. -->

        <item>
            <title>Version 1.0.1</title>
            <pubDate>Mon, 25 May 2026 22:56:47 +0200</pubDate>
            <sparkle:version>2</sparkle:version>
            <sparkle:shortVersionString>1.0.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[
                <h3>What is new</h3>
                <ul>
                    <li><b>Help menu</b> has two new entries: <i>Show Diagnostic Log in Finder</i> (Cmd+Opt+L) and <i>Copy Diagnostic Log to Clipboard</i>.</li>
                    <li><b>Log file</b> at <code>~/Library/Logs/NotesMap/NotesMap.log</code>, mirrors to OSLog. Auto-rotates on each launch, keeps the 5 newest archives.</li>
                    <li><b>One-shot DB diagnostic</b> on first build captures the NoteStore.sqlite shape (Z_ENT distribution, Z_PRIMARYKEY entity map, note counts) so schema mismatches across macOS versions can be pinpointed from a log file alone.</li>
                </ul>
                <h3>Privacy</h3>
                <p>No note content, titles, or folder names are ever logged. Only counts, status flags, and CoreData entity metadata. Nothing is sent anywhere automatically; log sharing is fully user-driven via the Help menu.</p>
            ]]></description>
            <enclosure
                url="https://github.com/floriankuemmel/notesmap-mac/releases/download/v1.0.1/NotesMap-1.0.1.dmg"
                sparkle:edSignature="9h/PDBF3ZoQF9ZDTuqmU7yLF8GgOJw0kBz7O9A1mI/5FmQg0K3Df+h5boAJtnEceJ9RRSofbYOZZU7esvSlqBQ=="
                length="11148536"
                type="application/octet-stream" />
        </item>

    </channel>
</rss>
